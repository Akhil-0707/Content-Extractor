# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=training
POSTGRES_PASSWORD=change-me
POSTGRES_DB=training
DATABASE_URL=postgresql+asyncpg://training:change-me@postgres:5432/training

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=documents

# --- Auth ---
JWT_SECRET=generate-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Local AI services (all on-prem) ---
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen3-4b-instruct-ft-q4_k_m
WHISPER_MODEL=distil-large-v3
EMBEDDING_MODEL=BAAI/bge-m3
SEARXNG_URL=http://searxng:8080

# --- Uploads ---
MAX_UPLOAD_BYTES=3221225472

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
